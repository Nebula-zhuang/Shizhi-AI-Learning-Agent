# =============================================================================
# Learning Buddy · 环境变量模板
# =============================================================================
# 使用方式：
#   1. 复制本文件为 .env 放在项目根目录：  cp .env.example .env
#   2. 按下方注释填入真实值
#   3. .env 已被 .gitignore 忽略，任何密钥都不会进版本库
#
# 约定：代码中不存在任何硬编码的密钥、口令、地址，全部由本文件注入。
#       新增配置项时，请同步更新 app/core/config.py 与本模板。
# =============================================================================

# -----------------------------------------------------------------------------
# 应用
# -----------------------------------------------------------------------------
APP_NAME=Learning Buddy API
# dev | test | prod
APP_ENV=dev
DEBUG=true
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# LLM 网关（OpenAI 兼容协议，切换服务商只改这三项）
# -----------------------------------------------------------------------------
# 模式：auto | live | mock
#   auto —— 有 API Key 就走 live，没有就自动降级为 mock（默认，最省心）
#   live —— 强制真实调用，缺少 Key 会直接报错
#   mock —— 强制本地模拟流式输出，用于无 Key 时验证前后端链路
LLM_MODE=auto

# 【必填】主用一家模型服务商的兼容端点。常见取值：
#   DeepSeek   https://api.deepseek.com/v1            模型 deepseek-chat
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4   模型 glm-4-plus
#   OpenAI     https://api.openai.com/v1              模型 gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1

# 【必填】密钥。留空则自动进入 mock 模式
LLM_API_KEY=

LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60


# -----------------------------------------------------------------------------
# MySQL（业务事实数据 + 学习状态）
# -----------------------------------------------------------------------------
# 注意：MYSQL_PASSWORD 为空时写 MYSQL_PASSWORD=（值留空即可），不要加引号
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=learning_buddy
MYSQL_CHARSET=utf8mb4

# 可选：直接指定完整连接串，优先级高于上面的分项配置
# 用途一：切换到其他库；用途二：用 SQLite 快速验证迁移文件（无需 MySQL）
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/learning_buddy?charset=utf8mb4
# DATABASE_URL=sqlite:///./data/dev.db


# -----------------------------------------------------------------------------
# Chroma 向量库（embedded 模式，数据落本地磁盘）
# -----------------------------------------------------------------------------
# 留空则由代码按项目根目录推导为 <项目根>/data/chroma
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION=learning_buddy_chunks


# -----------------------------------------------------------------------------
# Embedding（P3 使用，P0 仅登记配置）
# -----------------------------------------------------------------------------
# api | local
#   api   —— 走云端 Embedding 接口，MVP 推荐，免 GPU 依赖
#   local —— 走本地 bge-m3，需要自备模型与算力
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG 检索必需。留空时索引与问答接口会明确返回 409（不会静默降级成假向量）。
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# RAG 检索参数（P3）
# -----------------------------------------------------------------------------
# RAG_MAX_DISTANCE 是余弦距离上限，超过的片段视为不相关并丢弃。
# 默认 0.40 是用 text-embedding-v3 在真实语料上实测校准出来的
# （资料内问题最大 0.29、资料外问题最小 0.41）。**换向量模型后应重新校准**：
#   python scripts/calibrate_rag.py --document-id <资料id> --auto-questions
# RAG_TOP_K=5
# RAG_MAX_DISTANCE=0.40
# RAG_MAX_CONTEXT_CHARS=6000


# -----------------------------------------------------------------------------
# 外部检索工具（P2 可信度核验使用）
# 注意：这是应用自身运行时的联网能力，必须由应用自己持有 Key
# -----------------------------------------------------------------------------
# 【要启用联网核验，只需要填这一个】
# 去 https://app.tavily.com 注册（有免费额度）拿到 key，填在下面。
# 填好之后重启后端，L3 联网核验会自动生效；不填则 L3 整层记 skipped，
# L1 规则校验与 L2 模型自评照常跑 —— 这是设计上的降级，不是故障。
#
# ⚠️ 不填的时候，助教被明确禁止说「我上网查过」这类话
#    （见 app/services/verify_voice.py），不会拿外部知识冒充已核实的结论。
TAVILY_API_KEY=
# Serper 暂时没有实现（config 里留了字段，但没有对应客户端）。留空即可。
SERPER_API_KEY=


# -----------------------------------------------------------------------------
# 文件上传（P1 使用）
# -----------------------------------------------------------------------------
# 单文件上限（MB）。300 是"本地单机 + 流式落盘"下能稳住的量级：
# 后端边收边写盘，内存占用固定在 1MB 量级，所以上限取决于磁盘；
# 但解析阶段仍会把整份文件交给 PyMuPDF / OCR，不宜再往上抬。
# ⚠️ 前端 apps/web/src/api/upload.ts 里的 MAX_UPLOAD_MB 必须与此一致，
#    否则会出现"前端放行、后端 413 拒绝"的割裂体验。
MAX_UPLOAD_MB=300

# 单文档最多允许多少个抽取批次（每批约 4 个文本块）。
# ⚠️ 这是与 MAX_UPLOAD_MB **无关的第二个上限**：
#    MAX_UPLOAD_MB 管"能不能收下这个文件"，
#    这一项管"收下之后要调多少次模型"—— 后者才是真花时间和花钱的地方。
# 300 批 ≈ 1200 个文本块 ≈ 两三百万字，已远超一门课一学期的材料量。
# PDF 另有 MAX_DOCUMENT_PAGES 兜着，这一项主要防超大 docx / md / txt。
MAX_EXTRACT_BATCHES=300
# 留空则推导为 <项目根>/data/uploads
UPLOAD_DIR=


# -----------------------------------------------------------------------------
# 前端（apps/web/.env.local，Vite 只暴露 VITE_ 前缀的变量）
# -----------------------------------------------------------------------------
# 默认留空即可 —— 前端通过 Vite 代理 /api 访问后端，开发期无需跨域配置
# 仅在前后端分离部署时设置为后端完整地址：
# VITE_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 视觉模型与快速模型
# -----------------------------------------------------------------------------
# ⚠️ **主模型在**上面的「LLM」段里配置（`LLM_BASE_URL` / `LLM_MODEL`），
#    这里刻意**不重复定义** —— `.env` 里同名变量**最后一个生效**，
#    重复定义会让人改了上面那处却不生效。
#
# 视觉任务走单独的 VL 模型：图只在"用户真的传了"时出现，
# 让每一轮纯文本对话都付 VL 模型的价钱不划算。
#
# 各家的 base_url / 主模型 / 视觉模型对照：
#   阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus     视觉 qwen-vl-max
#   DeepSeek    https://api.deepseek.com/v1                        deepseek-chat 无视觉
#   智谱 GLM    https://open.bigmodel.cn/api/paas/v4                glm-4-plus    视觉 glm-4v-plus
#   OpenAI      https://api.openai.com/v1                          gpt-4o-mini   视觉 gpt-4o

# 轻量任务（如意图分类）用的更便宜的模型。留空 = 与主模型相同。
LLM_MODEL_FAST=

# ---- 视觉（多模态）----------------------------------------------------------
# 留空 = 本部署不支持看图。
LLM_VISION_MODEL=
#
# ⚠️ **必须按部署显式声明，不能靠"发过去看行不行"。**
#    不支持视觉的模型**接口不会报错**，只会回一句"我看不到图"，
#    工具于是返回一个"成功"的废结果，Agent 还会白转好几轮。
#
# 打开条件：LLM_VISION_MODEL 已配置，且**实测该模型能读出图里的内容**。
LLM_SUPPORTS_VISION=false


# -----------------------------------------------------------------------------
# 联网搜索（自由学习 / 可信度核验共用）
# -----------------------------------------------------------------------------
# 三种模式：
#   auto    优先 MCP；运行时故障（连不上 / 401 / 超时）回退 Tavily，并上报回退原因
#   mcp     只用 MCP。失败就明确失败，不偷偷换 —— 便于验证 MCP 真的在工作
#   tavily  只用 Tavily，**不发起任何 MCP 请求**
#
# ⚠️ 有一条回退规则是刻意的：MCP 连上了但**能力清单里没有搜索工具**时不回退。
#    那是配置/兼容性错误，不是网络问题。静默回退会把"工具名对不上"
#    永远掩盖成"网络偶尔不好"，你会一直以为 MCP 在工作。
WEB_SEARCH_BACKEND=auto

# ---- MCP（Tavily 官方 Server，远程 HTTP）------------------------------------
# 用远程端点而不是本地 npx：不需要在本机跑 Node 子进程，
# 也就绕开了"某些环境下 npm 装不上"这类问题。
MCP_WEB_SEARCH_URL=https://mcp.tavily.com/mcp/
MCP_TIMEOUT_S=20

# ---- Tavily ----------------------------------------------------------------
# ⚠️ `TAVILY_API_KEY` 在**上面的「联网核验」段**里配置，这里不重复定义 ——
#    同一个 Key 既给 MCP 也给 Tavily REST 用，本来就不需要配两份。
#    申请：https://app.tavily.com/home

TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_S=10
# basic 更便宜，advanced 更准
TAVILY_SEARCH_DEPTH=basic
# 单次搜索返回内容的截断长度，避免把长正文灌进证据
TAVILY_SNIPPET_CHARS=300


# -----------------------------------------------------------------------------
# Agent Loop（自由学习的工具编排）
# -----------------------------------------------------------------------------
# 三条硬限制**缺一不可**：
#   · 只有调用数限制 → 模型可以反复"不调工具也不回答"，空转
#   · 只有步数限制   → 一步里并发调多个工具，成本失控
#   · 没有总时限     → 每次调用都快但次数多，用户干等
#
# 超限不是报错，而是**降级到最终回答**（拿已有信息回答并说明"还有一步没做完"）。
LOOP_MAX_STEPS=6
LOOP_MAX_TOOL_CALLS=3
#
# ⚠️ 这一项约束的是**工具编排**，不约束最终生成 ——
#    生成就是降级目标本身，给它设时限超时后就什么都输出不了。
#    所以 30 秒应理解为"愿意在工具编排上花多久"，
#    用户实际等待 ≈ 编排耗时 + 生成耗时。
LOOP_TIMEOUT_S=30


# -----------------------------------------------------------------------------
# 鉴权与会话
# -----------------------------------------------------------------------------
# ⚠️ JWT_SECRET 是**签名密钥**，泄露等于任何人都能伪造登录态。
#    生产环境请生成一个随机值，例如：
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#    留空时后端会使用一个仅限本机开发的默认值 —— **绝不要带到线上**。
JWT_SECRET=

# 登录态有效期（分钟）。默认 7 天。
JWT_EXPIRE_MINUTES=10080

# 生产环境走 HTTPS 时必须设为 true，否则 cookie 会被浏览器拒绝。
COOKIE_SECURE=false

# ---- 演示账号（仅用于本机演示与端到端脚本）----------------------------------
# 留空则不创建演示账号。
# ⚠️ 这两个值**只应出现在本机 .env**，不要写进任何提交到仓库的文件。
DEMO_USERNAME=
DEMO_PASSWORD=
